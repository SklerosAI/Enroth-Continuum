if(NOT PROJECT_VERSION)
    set(PROJECT_VERSION "unknown")
endif()

find_package(Git)

if(GIT_FOUND AND EXISTS "${CMAKE_SOURCE_DIR}/.git")
  execute_process(COMMAND ${GIT_EXECUTABLE} describe --always --tags --dirty
    WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}
    OUTPUT_VARIABLE GIT_VERSION
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    RESULT_VARIABLE GIT_DESCRIBE_STATUS)

  if(GIT_DESCRIBE_STATUS EQUAL 0 AND NOT "${GIT_VERSION}" STREQUAL "")
    set(PROJECT_VERSION ${GIT_VERSION})
  endif()

  if(NOT EC_LOCAL_ONLY_CONFIGURE)
    execute_process(COMMAND ${GIT_EXECUTABLE} submodule update --init --recursive
      WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}
      OUTPUT_VARIABLE OPENENROTH_VERSION
      OUTPUT_STRIP_TRAILING_WHITESPACE)
  endif()
endif()

message(STATUS "OpenEnroth version: ${PROJECT_VERSION}")
