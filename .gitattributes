* text=auto
text eol=lf

*.c text
*.cpp text
*.h text
*.hpp text

*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.vcxproj.user text eol=crlf

# Preserve the pinned LuaJIT source blobs, including upstream CRLF scripts.
thirdparty/luajit/** -text
thirdparty/repo-source/** -text

# Preserve the upstream CRLF Natvis blob in the pinned GLM snapshot.
thirdparty/glm/util/glm.natvis -text
thirdparty/inifile_cpp/** -text
thirdparty/nlohmann_json/** -text
thirdparty/tcpp/** -text
