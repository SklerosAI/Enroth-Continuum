
function(download_prebuilt_dependencies TAG FILE_NAME TARGET_DIR OUT_STATUS_VAR)
    if(EC_LOCAL_ONLY_CONFIGURE)
        message(FATAL_ERROR "EC_LOCAL_ONLY_CONFIGURE forbids the OpenEnroth dependency archive; repository-owned SDL3, OpenAL Soft, FFmpeg, libpng and zlib-ng builds are required")
    endif()
    set(SOURCE_URL "https://github.com/OpenEnroth/OpenEnroth_Dependencies/releases/download/${TAG}/${FILE_NAME}")
    set(TARGET_PATH "${TARGET_DIR}/${FILE_NAME}")
    message(STATUS "Downloading ${SOURCE_URL} to ${TARGET_PATH}...")
    file(DOWNLOAD
            "${SOURCE_URL}"
            "${TARGET_PATH}"
            SHOW_PROGRESS
            STATUS DOWNLOAD_STATUS
            TIMEOUT 60)  # seconds

    list(GET DOWNLOAD_STATUS 0 STATUS_CODE)
    list(GET DOWNLOAD_STATUS 1 ERROR_MESSAGE)
    if(STATUS_CODE EQUAL 0)
        message(STATUS "Downloaded ${SOURCE_URL}!")
    else()
        file(REMOVE "${TARGET_PATH}")
        message(WARNING "Could not download ${SOURCE_URL}: ${ERROR_MESSAGE}")
        set(${OUT_STATUS_VAR} 1 PARENT_SCOPE)
        return()
    endif()

    message(STATUS "Extracting ${TARGET_PATH} to ${TARGET_DIR}")
    execute_process(COMMAND ${CMAKE_COMMAND} -E tar xzf "${TARGET_PATH}"
            WORKING_DIRECTORY ${TARGET_DIR}
            RESULT_VARIABLE UNPACK_STATUS
            COMMAND_ECHO STDOUT)

    if (UNPACK_STATUS)
        message(WARNING "Could not unpack ${TARGET_PATH}: ${UNPACK_STATUS}")
        set(${OUT_STATUS_VAR} 1 PARENT_SCOPE)
        return()
    endif()

    set(${OUT_STATUS_VAR} 0 PARENT_SCOPE)
endfunction()

# The opt-in lane validates the local source-built prefix before CMake resolves
# packages. Remaining gitlinks or nested sources still stop a clean build.
set(EC_LOCAL_DEPS_PREFIX "" CACHE PATH "Static Mac dependency prefix built from thirdparty/repo-source")

function(validate_repository_owned_dependency_prefix OUT_PREFIX)
    if(NOT OE_BUILD_PLATFORM STREQUAL "darwin" OR NOT OE_BUILD_ARCHITECTURE STREQUAL "arm64")
        message(FATAL_ERROR "EC_LOCAL_ONLY_CONFIGURE currently requires a native Mac arm64 build")
    endif()
    if(NOT CMAKE_BUILD_TYPE MATCHES "^(Debug|Release|RelWithDebInfo)$")
        message(FATAL_ERROR "EC_LOCAL_ONLY_CONFIGURE requires Debug, Release or RelWithDebInfo")
    endif()
    if(NOT EC_LOCAL_DEPS_PREFIX OR NOT IS_ABSOLUTE "${EC_LOCAL_DEPS_PREFIX}" OR
       NOT IS_DIRECTORY "${EC_LOCAL_DEPS_PREFIX}")
        message(FATAL_ERROR "EC_LOCAL_ONLY_CONFIGURE requires an absolute EC_LOCAL_DEPS_PREFIX from tools/build_mm7_macos_dependencies.py")
    endif()
    file(REAL_PATH "${EC_LOCAL_DEPS_PREFIX}" PREFIX)
    get_filename_component(OUTPUT_ROOT "${PREFIX}" DIRECTORY)
    set(REPORT_PATH "${OUTPUT_ROOT}/build-report.json")
    set(SOURCE_MANIFEST_PATH "${CMAKE_SOURCE_DIR}/thirdparty/repo-source/SOURCES.json")
    if(NOT EXISTS "${REPORT_PATH}" OR NOT EXISTS "${SOURCE_MANIFEST_PATH}")
        message(FATAL_ERROR "EC_LOCAL_ONLY_CONFIGURE requires the local build report and repository source manifest")
    endif()
    file(READ "${REPORT_PATH}" REPORT_JSON)
    file(READ "${SOURCE_MANIFEST_PATH}" SOURCE_JSON)
    string(JSON REPORT_TYPE GET "${REPORT_JSON}" build_type)
    string(JSON REPORT_ARCH GET "${REPORT_JSON}" architecture)
    string(JSON REPORT_TARGET GET "${REPORT_JSON}" deployment_target)
    if(NOT REPORT_TYPE STREQUAL CMAKE_BUILD_TYPE OR
       NOT REPORT_ARCH STREQUAL "arm64" OR NOT REPORT_TARGET STREQUAL "11.0")
        message(FATAL_ERROR "EC_LOCAL_ONLY_CONFIGURE local dependency report has the wrong build type, architecture or deployment target")
    endif()

    string(JSON SOURCE_COUNT LENGTH "${SOURCE_JSON}" sources)
    string(JSON REPORT_SOURCE_COUNT LENGTH "${REPORT_JSON}" source_commits)
    if(NOT SOURCE_COUNT EQUAL 5 OR NOT REPORT_SOURCE_COUNT EQUAL 5)
        message(FATAL_ERROR "EC_LOCAL_ONLY_CONFIGURE requires exactly five pinned Mac media sources")
    endif()
    set(EXPECTED_FAMILIES SDL3 ffmpeg libpng openal-soft zlib-ng)
    math(EXPR SOURCE_LAST "${SOURCE_COUNT} - 1")
    foreach(INDEX RANGE 0 ${SOURCE_LAST})
        string(JSON FAMILY GET "${SOURCE_JSON}" sources ${INDEX} path)
        if(NOT FAMILY IN_LIST EXPECTED_FAMILIES)
            message(FATAL_ERROR "EC_LOCAL_ONLY_CONFIGURE unexpected Mac media source: ${FAMILY}")
        endif()
        list(REMOVE_ITEM EXPECTED_FAMILIES "${FAMILY}")
        string(JSON SOURCE_PIN GET "${SOURCE_JSON}" sources ${INDEX} commit)
        string(JSON REPORT_PIN GET "${REPORT_JSON}" source_commits ${FAMILY})
        if(NOT REPORT_PIN STREQUAL SOURCE_PIN)
            message(FATAL_ERROR "EC_LOCAL_ONLY_CONFIGURE ${FAMILY} source pin differs from local build report")
        endif()
    endforeach()
    if(EXPECTED_FAMILIES)
        message(FATAL_ERROR "EC_LOCAL_ONLY_CONFIGURE source manifest omits Mac media families")
    endif()

    set(ARCHIVES libSDL3.a libopenal.a libavcodec.a libavformat.a libavutil.a
                 libswscale.a libswresample.a)
    if(CMAKE_BUILD_TYPE STREQUAL "Debug")
        list(APPEND ARCHIVES libzd.a libpng16d.a)
    else()
        list(APPEND ARCHIVES libz.a libpng16.a)
    endif()
    foreach(ARCHIVE IN LISTS ARCHIVES)
        set(ARCHIVE_PATH "${PREFIX}/lib/${ARCHIVE}")
        if(NOT EXISTS "${ARCHIVE_PATH}" OR IS_SYMLINK "${ARCHIVE_PATH}")
            message(FATAL_ERROR "EC_LOCAL_ONLY_CONFIGURE missing regular static archive: ${ARCHIVE}")
        endif()
        string(JSON EXPECTED_HASH GET "${REPORT_JSON}" archives_sha256 ${ARCHIVE})
        file(SHA256 "${ARCHIVE_PATH}" ACTUAL_HASH)
        if(NOT ACTUAL_HASH STREQUAL EXPECTED_HASH)
            message(FATAL_ERROR "EC_LOCAL_ONLY_CONFIGURE archive hash changed: ${ARCHIVE}")
        endif()
        execute_process(COMMAND /usr/bin/lipo -info "${ARCHIVE_PATH}"
                        OUTPUT_VARIABLE ARCH_INFO RESULT_VARIABLE ARCH_RESULT
                        OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT ARCH_RESULT EQUAL 0 OR NOT ARCH_INFO MATCHES "architecture: arm64$")
            message(FATAL_ERROR "EC_LOCAL_ONLY_CONFIGURE archive is not arm64: ${ARCHIVE}")
        endif()
    endforeach()
    file(GLOB ALL_ARCHIVES "${PREFIX}/lib/*.a")
    set(REGULAR_ARCHIVES)
    foreach(ARCHIVE_PATH IN LISTS ALL_ARCHIVES)
        if(NOT IS_SYMLINK "${ARCHIVE_PATH}")
            list(APPEND REGULAR_ARCHIVES "${ARCHIVE_PATH}")
        endif()
    endforeach()
    list(LENGTH REGULAR_ARCHIVES REGULAR_COUNT)
    if(NOT REGULAR_COUNT EQUAL 9)
        message(FATAL_ERROR "EC_LOCAL_ONLY_CONFIGURE found unexpected static archives in local prefix")
    endif()
    file(GLOB SHARED_LIBRARIES "${PREFIX}/lib/*.dylib")
    if(SHARED_LIBRARIES)
        message(FATAL_ERROR "EC_LOCAL_ONLY_CONFIGURE found a dynamic library in local prefix")
    endif()
    set(FFMPEG_CONFIG "${OUTPUT_ROOT}/build/ffmpeg/config.h")
    if(NOT EXISTS "${FFMPEG_CONFIG}")
        message(FATAL_ERROR "EC_LOCAL_ONLY_CONFIGURE missing FFmpeg feature manifest")
    endif()
    string(JSON EXPECTED_CONFIG_HASH GET "${REPORT_JSON}" ffmpeg_config_h_sha256)
    file(SHA256 "${FFMPEG_CONFIG}" ACTUAL_CONFIG_HASH)
    if(NOT ACTUAL_CONFIG_HASH STREQUAL EXPECTED_CONFIG_HASH)
        message(FATAL_ERROR "EC_LOCAL_ONLY_CONFIGURE FFmpeg feature manifest changed")
    endif()
    file(STRINGS "${FFMPEG_CONFIG}" LICENSE_FLAGS REGEX "^#define CONFIG_(GPL|VERSION3|NONFREE) 0$")
    list(LENGTH LICENSE_FLAGS FLAG_COUNT)
    if(NOT FLAG_COUNT EQUAL 3)
        message(FATAL_ERROR "EC_LOCAL_ONLY_CONFIGURE FFmpeg GPL/version3/nonfree flags are not all disabled")
    endif()
    string(JSON NOTICE_COUNT LENGTH "${REPORT_JSON}" notice_files_sha256)
    if(NOT NOTICE_COUNT GREATER 0)
        message(FATAL_ERROR "EC_LOCAL_ONLY_CONFIGURE local dependency report contains no notices")
    endif()
    math(EXPR NOTICE_LAST "${NOTICE_COUNT} - 1")
    foreach(INDEX RANGE 0 ${NOTICE_LAST})
        string(JSON NOTICE_NAME MEMBER "${REPORT_JSON}" notice_files_sha256 ${INDEX})
        string(JSON EXPECTED_HASH GET "${REPORT_JSON}" notice_files_sha256 ${NOTICE_NAME})
        set(NOTICE_PATH "${PREFIX}/share/licenses/enroth-mm7-source/${NOTICE_NAME}")
        if(NOT EXISTS "${NOTICE_PATH}")
            message(FATAL_ERROR "EC_LOCAL_ONLY_CONFIGURE missing local dependency notice: ${NOTICE_NAME}")
        endif()
        file(SHA256 "${NOTICE_PATH}" ACTUAL_HASH)
        if(NOT ACTUAL_HASH STREQUAL EXPECTED_HASH)
            message(FATAL_ERROR "EC_LOCAL_ONLY_CONFIGURE local dependency notice hash changed: ${NOTICE_NAME}")
        endif()
    endforeach()
    set(${OUT_PREFIX} "${PREFIX}" PARENT_SCOPE)
endfunction()

function(require_repository_owned_dependencies)
    set(MISSING_INPUTS)
    if(APPLE AND EC_LOCAL_ONLY_CONFIGURE AND EC_MM7_MAC_ICONV_ADAPTER)
        set(LOCAL_MAC_ENCODING ON)
    else()
        set(LOCAL_MAC_ENCODING OFF)
    endif()
    if(EXISTS "${CMAKE_SOURCE_DIR}/.gitmodules")
        file(STRINGS "${CMAKE_SOURCE_DIR}/.gitmodules" SUBMODULE_LINES
             REGEX "^[ \t]*path[ \t]*=")
        foreach(LINE IN LISTS SUBMODULE_LINES)
            string(REGEX REPLACE "^[ \t]*path[ \t]*=[ \t]*" "" RELATIVE_PATH "${LINE}")
            if(LOCAL_MAC_ENCODING AND RELATIVE_PATH STREQUAL "thirdparty/ztd_text")
                continue()
            endif()
            list(APPEND MISSING_INPUTS "${RELATIVE_PATH} (external gitlink)")
        endforeach()
    endif()

    set(LOCAL_SOURCE_ROOT "${CMAKE_SOURCE_DIR}/thirdparty/repo-source")
    set(REQUIRED_SOURCE_NAMES SDL3 openal-soft ffmpeg libpng zlib-ng libdwarf-lite)
    if(NOT LOCAL_MAC_ENCODING)
        list(APPEND REQUIRED_SOURCE_NAMES ztd-cmake ztd-idk ztd-inline-containers
                                          ztd-encoding-tables ztd-cuneicode ztd-platform)
    endif()
    foreach(NAME IN LISTS REQUIRED_SOURCE_NAMES)
        file(GLOB SOURCE_ENTRIES "${LOCAL_SOURCE_ROOT}/${NAME}/*")
        if(NOT SOURCE_ENTRIES)
            list(APPEND MISSING_INPUTS "thirdparty/repo-source/${NAME}")
        endif()
    endforeach()
    if(MISSING_INPUTS)
        list(JOIN MISSING_INPUTS "\n  - " MISSING_MESSAGE)
        message(FATAL_ERROR "EC_LOCAL_ONLY_CONFIGURE missing repository-owned source inputs:\n  - ${MISSING_MESSAGE}")
    endif()

endfunction()

function(print_library_found_message LIBRARY TARGET_NAME INCLUDE_DIR)
    if(NOT "${TARGET_NAME}" STREQUAL "")
        get_target_property(TARGET_INCLUDE_DIR "${TARGET_NAME}" INTERFACE_INCLUDE_DIRECTORIES)
    endif()
    if("${TARGET_INCLUDE_DIR}" STREQUAL "")
        set(TARGET_INCLUDE_DIR "${INCLUDE_DIR}")
    endif()
    if(NOT "${TARGET_INCLUDE_DIR}" STREQUAL "")
        message(STATUS "${LIBRARY} found: ${TARGET_INCLUDE_DIR}")
    endif()
endfunction()

macro(resolve_dependencies) # Intentionally a macro - we want set() to work in parent scope.
    if(EC_LOCAL_ONLY_CONFIGURE)
        if(OE_USE_PREBUILT_DEPENDENCIES)
            message(FATAL_ERROR "EC_LOCAL_ONLY_CONFIGURE requires OE_USE_PREBUILT_DEPENDENCIES=OFF; the OpenEnroth dependency archive is forbidden")
        endif()
        validate_repository_owned_dependency_prefix(LOCAL_DEPENDENCY_PREFIX)
        require_repository_owned_dependencies()
        set(CMAKE_PREFIX_PATH "${LOCAL_DEPENDENCY_PREFIX}")
        set(CMAKE_FIND_USE_CMAKE_ENVIRONMENT_PATH OFF)
        set(CMAKE_FIND_USE_PACKAGE_REGISTRY OFF)
        set(CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY OFF)
        list(APPEND CMAKE_IGNORE_PREFIX_PATH /opt/homebrew /usr/local /usr/X11R6 /opt/anaconda3)
        set(CMAKE_FIND_FRAMEWORK LAST)
        set(ENV{PKG_CONFIG_PATH} "${LOCAL_DEPENDENCY_PREFIX}/lib/pkgconfig")
        set(ENV{PKG_CONFIG_LIBDIR} "${LOCAL_DEPENDENCY_PREFIX}/lib/pkgconfig")
        set(ZLIB_USE_STATIC_LIBS ON)
        if(CMAKE_BUILD_TYPE STREQUAL "Debug")
            set(LOCAL_ZLIB_NAME libzd.a)
            set(LOCAL_PNG_NAME libpng16d.a)
        else()
            set(LOCAL_ZLIB_NAME libz.a)
            set(LOCAL_PNG_NAME libpng16.a)
        endif()
        set(ZLIB_LIBRARY "${LOCAL_DEPENDENCY_PREFIX}/lib/${LOCAL_ZLIB_NAME}" CACHE FILEPATH "" FORCE)
        set(ZLIB_LIBRARY_RELEASE "${ZLIB_LIBRARY}" CACHE FILEPATH "" FORCE)
        set(ZLIB_LIBRARY_DEBUG "${ZLIB_LIBRARY}" CACHE FILEPATH "" FORCE)
        set(ZLIB_INCLUDE_DIR "${LOCAL_DEPENDENCY_PREFIX}/include" CACHE PATH "" FORCE)
        set(PNG_LIBRARY "${LOCAL_DEPENDENCY_PREFIX}/lib/${LOCAL_PNG_NAME}" CACHE FILEPATH "" FORCE)
        set(PNG_LIBRARY_RELEASE "${PNG_LIBRARY}" CACHE FILEPATH "" FORCE)
        set(PNG_LIBRARY_DEBUG "${PNG_LIBRARY}" CACHE FILEPATH "" FORCE)
        set(PNG_PNG_INCLUDE_DIR "${LOCAL_DEPENDENCY_PREFIX}/include" CACHE PATH "" FORCE)
        set(SDL3_DIR "${LOCAL_DEPENDENCY_PREFIX}/lib/cmake/SDL3" CACHE PATH "" FORCE)
        set(OpenAL_DIR "${LOCAL_DEPENDENCY_PREFIX}/lib/cmake/OpenAL" CACHE PATH "" FORCE)
        set(FFMPEG_LIBRARIES)
        set(FFMPEG_INCLUDE_DIRS)
        foreach(COMPONENT IN ITEMS AVCODEC AVFORMAT AVUTIL SWSCALE SWRESAMPLE)
            string(TOLOWER "${COMPONENT}" COMPONENT_NAME)
            set(${COMPONENT}_LIBRARIES "${LOCAL_DEPENDENCY_PREFIX}/lib/lib${COMPONENT_NAME}.a" CACHE FILEPATH "" FORCE)
            set(${COMPONENT}_INCLUDE_DIRS "${LOCAL_DEPENDENCY_PREFIX}/include" CACHE PATH "" FORCE)
        endforeach()
        foreach(COMPONENT IN ITEMS AVDEVICE AVFILTER POSTPROC)
            unset(${COMPONENT}_LIBRARIES CACHE)
            unset(${COMPONENT}_INCLUDE_DIRS CACHE)
        endforeach()
        set(FETCHCONTENT_SOURCE_DIR_LIBDWARF
            "${CMAKE_SOURCE_DIR}/thirdparty/repo-source/libdwarf-lite" CACHE PATH "" FORCE)
    endif()
    if(OE_USE_PREBUILT_DEPENDENCIES)
        # "r8" is version as set in yml files in OpenEnroth_Dependencies, "master" is a branch name. This way it's
        # possible to test with dependencies built from different branches of the OpenEnroth_Dependencies repo.
        set(PREBUILT_DEPS_TAG "deps_r8_master")

        message(STATUS "Using prebuilt dependencies with PREBUILT_DEPS_TAG=${PREBUILT_DEPS_TAG}")

        set(PREBUILT_DEPS_BUILD_TYPE "${CMAKE_BUILD_TYPE}")
        if (PREBUILT_DEPS_BUILD_TYPE STREQUAL "MinSizeRel")
            set(PREBUILT_DEPS_BUILD_TYPE "Release")
        endif()

        set(PREBUILT_DEPS_FILENAME "${OE_BUILD_PLATFORM}_${PREBUILT_DEPS_BUILD_TYPE}_${OE_BUILD_ARCHITECTURE}.zip")
        set(PREBUILT_DEPS_DIR "${CMAKE_CURRENT_BINARY_DIR}/dependencies/${PREBUILT_DEPS_TAG}")
        if (NOT EXISTS "${PREBUILT_DEPS_DIR}/${PREBUILT_DEPS_FILENAME}")
            download_prebuilt_dependencies("${PREBUILT_DEPS_TAG}" "${PREBUILT_DEPS_FILENAME}" "${PREBUILT_DEPS_DIR}" DOWNLOAD_STATUS)
            if(NOT DOWNLOAD_STATUS EQUAL 0)
                message(FATAL_ERROR "Downloading prebuilt dependencies failed, consider rerunning cmake with -DOE_USE_PREBUILT_DEPENDENCIES=OFF.")
            endif()
        endif()

        # Android sets CMAKE_FIND_ROOT_PATH and this breaks find_package for us. So we hack.
        if(CMAKE_FIND_ROOT_PATH)
            list(APPEND CMAKE_FIND_ROOT_PATH "${PREBUILT_DEPS_DIR}")
            list(APPEND CMAKE_MODULE_PATH "/")
            list(APPEND CMAKE_PREFIX_PATH "/")
        else()
            list(APPEND CMAKE_MODULE_PATH "${PREBUILT_DEPS_DIR}")
            list(APPEND CMAKE_PREFIX_PATH "${PREBUILT_DEPS_DIR}")
        endif()

        # Prebuilt zlib is static, so we instruct the find_package to look for the static one.
        set(ZLIB_USE_STATIC_LIBS ON)

        # Frameworks get in the way of finding proper headers for prebuilt dependencies.
        # On MacOS find_library looks for frameworks first by default, and thus finds png.h in Mono.framework, which
        # fucks everything up for us royally.
        set(CMAKE_FIND_FRAMEWORK LAST)
    else()
        message(STATUS "Not using prebuilt dependencies")
    endif()

    # Prebuilt & user-supplied deps are resolved using the same code here.
    find_package(ZLIB REQUIRED)
    find_package(FFmpeg REQUIRED)

    find_package(SDL3 CONFIG REQUIRED)
    add_library(SDL3OE INTERFACE)
    target_link_libraries(SDL3OE INTERFACE SDL3::SDL3)
    if(TARGET SDL3::SDL3main) # Not all platforms have SDL3main.
        target_link_libraries(SDL3OE INTERFACE SDL3::SDL3main)
    endif()
    add_library(SDL3::SDL3OE ALIAS SDL3OE)

    # This should find OpenALConfig.cmake that comes with OpenAL Soft.
    #
    # Not even trying to do this w/o CONFIG because on MacOS it will find a MacOS framework, and there are two
    # problems with it:
    # - `FindOpenAL.cmake` sets the link target to point to the framework dir, which obviously doesn't work. We
    #   should be linking to `Frameworks/OpenAL.framework/OpenAL.tbd`.
    # - OpenEnroth doesn't support OpenAL that ships with MacOS. As in, sound barely works.
    #
    # If you're getting an error here, try passing something like -DOPENAL_ROOT=/opt/homebrew/opt/openal-soft to cmake.
    find_package(OpenAL CONFIG REQUIRED)

    find_package(PNG REQUIRED)

    # On Android we somehow get OpenGL available by default, despite it not being findable by find_package. So we
    # just create a dummy lib.
    if(OE_BUILD_PLATFORM STREQUAL "android")
        add_library(OpenGL_GL INTERFACE)
        add_library(OpenGL::GL ALIAS OpenGL_GL)
    else()
        find_package(OpenGL REQUIRED)
    endif()

    print_library_found_message(OpenAL OpenAL::OpenAL "")
    print_library_found_message(ZLIB ZLIB::ZLIB "")
    print_library_found_message(FFmpeg "" "${AVCODEC_INCLUDE_DIRS}")
    print_library_found_message(SDL3 SDL3::SDL3 "")
    print_library_found_message(OpenGL OpenGL::GL "")
endmacro()
